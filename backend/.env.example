# Copy this file to backend/.env and adjust as needed. Never commit .env.

# Port for the web server
PORT=3000

# Secret used to sign session cookies. Use any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Database
# Leave DATABASE_URL empty to use the embedded PostgreSQL engine (PGlite);
# its files are stored in PGLITE_DATA_DIR (default: backend/.data/pglite).
# To use a PostgreSQL server instead, set e.g.:
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/nutricart
DATABASE_URL=
# PGLITE_DATA_DIR=./.data/pglite

# Open Food Facts asks API clients to identify themselves.
OFF_USER_AGENT=NutriCartSmartPantry/1.0 (SOFE3700 student project)
# Timeout for external API calls, in milliseconds
EXTERNAL_TIMEOUT_MS=10000
